{
  "name": "workbench-web",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "工作台 Web 版：AI 团队分工写代码、人只负责 review（内核 + 服务端 + 浏览器界面）",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "init": "node src/cli.mjs init",
    "web": "node scripts/workbench.mjs start",
    "web:stop": "node scripts/workbench.mjs stop",
    "web:status": "node scripts/workbench.mjs status",
    "web:logs": "node scripts/workbench.mjs logs",
    "serve": "node src/server/index.mjs",
    "worker": "node src/runner/worker.mjs",
    "enqueue": "node src/cli.mjs enqueue",
    "status": "node src/cli.mjs status",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs",
    "demo:reset": "node scripts/reset-demo.mjs",
    "demo:review": "node scripts/demo-review.mjs --fresh",
    "demo:stage": "node scripts/demo-stage.mjs --fresh",
    "demo:real": "node scripts/demo-real-review.mjs --fresh",
    "bench:real": "node scripts/bench-real.mjs --fresh",
    "shot:roles": "node scripts/shot-roles.mjs",
    "shot:projects": "node scripts/shot-projects.mjs",
    "shots": "node scripts/shots.mjs",
    "docs:diagrams": "node scripts/make-diagrams.mjs"
  }
}