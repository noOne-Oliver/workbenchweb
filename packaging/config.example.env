# workbench 配置样例 —— 拷到 /etc/workbench/workbench.env（chmod 600）后改。
# 系统里生效的配置文件按这个顺序找，先命中的赢：
#   $WB_ENV_FILE  ->  /etc/workbench/workbench.env  ->  <WB_HOME>/workbench.env
# 环境变量（WB_*）优先于文件内容；这里只写「和默认值不同」的项也行。

# ---- 路径 ----------------------------------------------------------------
WB_HOME=/opt/workbench
WB_WORKSPACE=/var/lib/workbench
WB_ROOT=/var/lib/workbench
WB_CODE=/opt/workbench/kernel
WB_DB=/var/lib/workbench/data/ledger.db
WB_OC_HOME=/var/lib/workbench/.oc

# ---- 监听 ----------------------------------------------------------------
# 0.0.0.0 才会被别的机器访问；只本机用就 127.0.0.1。
WB_HOST=0.0.0.0
WB_PORT=7317

# ---- 引擎 ----------------------------------------------------------------
# opencode（默认）| mock（不联网、不起引擎，只跑演示脚本）
WB_ENGINE=opencode
# 一般不用改，默认就是 $WB_HOME/engine/opencode
# WB_ENGINE_BIN=/opt/workbench/engine/opencode

# ---- 内网 OpenAI 兼容端点（必填，否则任务跑不起来）----------------------
WB_LLM_BASE_URL=https://llm.internal.example/v1
WB_LLM_MODEL=qwen3-coder-30b
# 密钥只写在这里（文件权限 600），doctor / status 只报"已配置"，绝不回显。
WB_LLM_API_KEY=sk-replace-me

# ---- 其它（按需）--------------------------------------------------------
# 脚本/自动化用的 break-glass 口令；设了它 /api/* 就强制要求身份。
# 人工登录请用 Web 界面首次启动生成的一次性口令（wb logs | grep 一次性口令）。
# WB_TOKEN=
# 每次任务的 token 预算
# WB_BUDGET=1000000
# 环境里没有 npm 时让护栏直接用 node --test（离线包里通常本来就该开）
# WB_NO_NPM=1
# 日志行数（wb logs 默认 80）
# WB_LOG_LINES=200
